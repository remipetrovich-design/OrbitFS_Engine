# ORBITFS ENGINE — canonical Vercel runtime environment
# Never commit real secrets.

# ---------------------------------------------------------------------------
# REQUIRED — same shared OrbitFS Supabase project
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
ORBITFS_DB_SECRET=YOUR_SERVER_DATABASE_SECRET

# ---------------------------------------------------------------------------
# INSTALLATION-SPECIFIC SERVICE URLS
# ---------------------------------------------------------------------------
ORBITFS_PANEL_URL=https://YOUR_PANEL.vercel.app
ORBITFS_ENGINE_HOST_URL=https://YOUR_ENGINE.vercel.app

# ---------------------------------------------------------------------------
# LICENSE VERIFICATION
# ---------------------------------------------------------------------------
ORBITFS_LICENSE_REFRESH_MINUTES=30
ORBITFS_LICENSE_TIMEOUT_MS=8000
ORBITFS_ENTITLEMENT_PUBLIC_KEY=

# Public installed-product license validation API.
ORBITFS_LICENSE_API_URL=https://incendiarynetworks.cc/api/v1/license

# ---------------------------------------------------------------------------
# GITHUB ACTIONS RELEASE SECRETS — NOT Vercel runtime variables
# ---------------------------------------------------------------------------
# LICENSE_MASTER_API_TOKEN
#   Managed License Master integration key with releases.write.
# LICENSE_MASTER_URL
#   GitHub Actions repository variable:
#   https://incendiarynetworks.cc/api/v1
# No Billing Store release token is required for Stage 1 packaging.
# The Update workflow hands the candidate directly to License Manager.
