{
  "type": "object",
  "properties": {
    "port": {
      "type": "integer",
      "default": 3939,
      "minimum": 1024,
      "maximum": 65535
    },
    "publicBaseUrl": {
      "type": "string",
      "default": "https://mcp.orbitfs.cc/mcp"
    },
    "publicStorageRoot": {
      "type": "string",
      "default": ""
    },
    "maxDocumentFileBytes": {
      "type": "integer",
      "default": 20971520,
      "minimum": 1048576,
      "maximum": 104857600
    },
    "maxMediaFileBytes": {
      "type": "integer",
      "default": 262144000,
      "minimum": 10485760,
      "maximum": 1073741824
    },
    "maxMediaOutputBytes": {
      "type": "integer",
      "default": 12582912,
      "minimum": 1048576,
      "maximum": 52428800
    },
    "mediaChunkSeconds": {
      "type": "integer",
      "default": 600,
      "minimum": 60,
      "maximum": 1800
    },
    "mediaMaxChunks": {
      "type": "integer",
      "default": 12,
      "minimum": 1,
      "maximum": 48
    },
    "videoFrameIntervalSeconds": {
      "type": "integer",
      "default": 15,
      "minimum": 5,
      "maximum": 300
    },
    "videoMaxFrames": {
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "maximum": 32
    },
    "serviceName": {
      "type": "string",
      "default": "OrbitFSMcpServer"
    },
    "autoStart": {
      "type": "boolean",
      "default": true
    },
    "allowPublicFallback": {
      "type": "boolean",
      "default": false
    },
    "chatgptAuthMode": {
      "type": "string",
      "enum": [
        "oauth"
      ],
      "default": "oauth"
    },
    "controlToken": {
      "type": "string",
      "minLength": 32,
      "writeOnly": true,
      "format": "password"
    },
    "oauthStatePath": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "port",
    "publicStorageRoot",
    "serviceName"
  ]
}
